# Poort waarop de app draait
PORT=3000

# Map waar de database wordt bewaard (moet persistent zijn!)
DATA_DIR=./data

# Geheime tokens in de URL. Wissel deze door nieuwe waarden om oude links
# ongeldig te maken. Genereer een nieuwe met:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BEHEER_TOKEN=verander-mij-beheer-token
SCHOONMAAK_TOKEN=verander-mij-schoonmaak-token

# Optionele pincode. Leeg laten = uitgeschakeld.
# Wordt eenmalig gevraagd en onthouden in localStorage.
PINCODE=
